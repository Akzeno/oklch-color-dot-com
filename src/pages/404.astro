---
import AppLayout from '../layouts/AppLayout.astro';
import { getAllNavItemsFlat } from '../config/navigation';

const tools = getAllNavItemsFlat().filter((item) =>
  ['/', '/hex-to-oklch', '/oklch-to-hex', '/rgb-to-oklch', '/oklch-color-palette-generator', '/learn/what-is-oklch'].includes(
    item.path
  )
);
---

<AppLayout
  title="Page Not Found - OKLCH Color Tools"
  description="The page you were looking for does not exist. Jump back to the OKLCH color picker, converters or palette generator."
  canonicalPath="/404"
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 py-16 space-y-8">
    <div class="space-y-3">
      <p class="text-xs font-mono text-mute">404</p>
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">Page not found</h1>
      <p class="text-sm text-body leading-relaxed">
        This URL does not exist on oklchcolor.com. It may have been a typo, or the page may have
        moved. Pick a tool below and carry on converting colors.
      </p>
    </div>

    <section class="space-y-3">
      <h2 class="text-base font-semibold text-ink">Popular tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {tools.map((item) => (
          <a
            href={item.path}
            class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors space-y-1"
          >
            <span class="text-sm font-semibold text-ink block">{item.seo.h1}</span>
            <span class="text-xs font-mono text-body">{item.seo.metaDescription.split('.')[0]}.</span>
          </a>
        ))}
      </div>
    </section>

    <p class="text-xs font-mono text-mute">
      <a href="/" class="hover:text-ink underline">Back to the OKLCH color picker</a>
    </p>
  </div>
</AppLayout>
