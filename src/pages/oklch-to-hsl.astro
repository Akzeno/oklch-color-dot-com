---
import AppLayout from '../layouts/AppLayout.astro';
import ConverterIsland from '../components/converters/ConverterIsland';
import RelatedTools from '../components/common/RelatedTools.astro';
import { getBuildTimeColorTable } from '../utils/seoTables';
import { parseAnyToOklch, formatOklch } from '../utils/color';
import { localizedSeo } from '../i18n/seo';
import { t } from '../i18n/translations';
import { buildLocalizedPath, type LocaleCode } from '../i18n/config';

interface Props {
  locale?: LocaleCode;
}
const { locale = 'en' } = Astro.props;

const seo = localizedSeo('/oklch-to-hsl', locale, {
  title: 'OKLCH to HSL Converter - Free CSS Color Tool',
  metaDescription:
    'Convert CSS oklch() colors to hsl(h, s%, l%) instantly. Free OKLCH to HSL converter with automatic sRGB gamut mapping.',
  h1: 'OKLCH to HSL Converter',
  keywords: ['oklch to hsl', 'oklch to hsl converter', 'oklch fallback to hsl'],
  schemaType: 'WebApplication',
});

const examplesTable = getBuildTimeColorTable('oklch-to-hsl');

const sampleColor = parseAnyToOklch('#3b82f6');
const sampleOklch = sampleColor ? formatOklch(sampleColor) : 'oklch(62.3% 0.188 259.8)';

const cssSnippet = t(
  locale,
  'pages.oklchToHsl.cssSnippet',
  '.link {\n  color: hsl(217, 91%, 60%); /* fallback */\n  color: {sample}; /* modern browsers */\n}'
).replace('{sample}', sampleOklch);
---

<AppLayout
  title={seo.title}
  description={seo.metaDescription}
  keywords={seo.keywords}
  canonicalPath="/oklch-to-hsl"
  schemaType={seo.schemaType}
  locale={locale}
>
  <div class="max-w-5xl mx-auto px-4 py-6 md:py-8 space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>
      <p class="text-xs md:text-sm font-mono text-body" set:html={t(locale, 'pages.oklchToHsl.subtitle', 'Convert CSS <code class="text-ink">oklch()</code> colors to standard <code class="text-ink">hsl(h, s%, l%)</code> strings with automated gamut mapping.')} />
    </div>

    <section aria-label={t(locale, 'pages.oklchToHsl.toolAriaLabel', 'OKLCH to HSL Converter Tool')}>
      <ConverterIsland client:load initialMode="oklch-to-hsl" locale={locale} />
    </section>

    <div class="space-y-10 pt-8 border-t border-hairline">
      <!-- 1. Intro -->
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.oklchToHsl.whyTitle', 'Why Convert OKLCH to HSL?')}</h2>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.oklchToHsl.whyBody', 'While modern front-end workflows embrace OKLCH, certain legacy CSS preprocessors, email clients, or native apps continue to mandate HSL formats. Our engine translates OKLCH into standard 360-degree HSL values with graceful gamut clamping.')}
        </p>
      </section>

      <!-- 2. How to Convert -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-6">
        <h2 class="text-base font-semibold text-ink">{t(locale, 'pages.oklchToHsl.howTitle', 'How to Convert OKLCH to HSL')}</h2>
        <ol class="space-y-2 text-xs font-mono text-body list-decimal list-inside">
          <li set:html={t(locale, 'pages.oklchToHsl.step1', 'Paste any <code class="text-ink">oklch()</code> value (e.g. <code class="text-ink">oklch(62.3% 0.188 259.8)</code>) into the input field above.')} />
          <li>{t(locale, 'pages.oklchToHsl.step2', 'Our engine converts OKLCH to Oklab, then through the inverse LMS matrix to linear RGB, then gamma-encodes to sRGB.')}</li>
          <li>{t(locale, 'pages.oklchToHsl.step3', 'sRGB is converted to HSL cylindrical coordinates: hue (0-360), saturation (0-100%), lightness (0-100%).')}</li>
        </ol>
        <p class="text-xs md:text-sm font-mono text-body pt-2" set:html={t(locale, 'pages.oklchToHsl.mathPath', '<strong class="text-ink">The math path:</strong> OKLCH → Oklab (Cartesian) → linear RGB (inverse LMS) → gamma-encoded sRGB → HSL (cylindrical transform).')} />
      </section>

      <!-- 3. Reference Table -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.oklchToHsl.referenceTitle', 'OKLCH to HSL Reference Values')}</h2>
        <div class="bg-canvas-card border border-hairline rounded-xl overflow-hidden shadow-lg">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-canvas-elevated border-b border-hairline text-mute text-[11px] uppercase">
                <tr>
                  <th class="p-3">{t(locale, 'pages.oklchToHsl.thSwatch', 'Swatch')}</th>
                  <th class="p-3">{t(locale, 'pages.oklchToHsl.thOklchInput', 'OKLCH Input')}</th>
                  <th class="p-3">{t(locale, 'pages.oklchToHsl.thColorName', 'Color Name')}</th>
                  <th class="p-3">{t(locale, 'pages.oklchToHsl.thHslOutput', 'HSL Output')}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                {examplesTable.map((row) => (
                  <tr class="hover:bg-canvas-elevated transition-colors">
                    <td class="p-3">
                      <div class="w-6 h-6 rounded border border-white/20" style={`background-color: ${row.oklch};`} />
                    </td>
                    <td class="p-3 text-copy-success">{row.oklch}</td>
                    <td class="p-3 text-ink font-medium">{row.name}</td>
                    <td class="p-3 text-body">{row.hsl}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 4. CSS Snippet -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5">
        <h2 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.cssSnippetTitle', 'Copy-Ready CSS with Progressive Enhancement')}</h2>
        <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
          <code>{cssSnippet}</code></pre>
        <p class="text-xs md:text-sm font-mono text-body pt-2">
          <strong class="text-ink">Tailwind CSS v4 @theme:</strong>
        </p>
        <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
          <code>@theme &#123;{'\n'}  --color-link-blue: {sampleOklch};{'\n'}&#125;</code></pre>
      </section>

      <!-- 5. Gamut Note -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5 md:p-6">
        <h2 class="text-base font-semibold text-ink">{t(locale, 'pages.oklchToHsl.gamutTitle', 'Gamut Note: Automatic sRGB Mapping')}</h2>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.oklchToHsl.gamutBody', 'When an OKLCH color falls outside the sRGB gamut, our engine automatically clamps chroma to the nearest in-gamut value while preserving hue. The resulting HSL value is always valid and renders consistently across all displays.')}
        </p>
        <ul class="space-y-2 text-xs font-mono text-body list-disc list-inside">
          <li set:html={t(locale, 'pages.oklchToHsl.gamutLi1', '<strong class="text-ink">Display-P3 Colors:</strong> On wide-gamut monitors, the original OKLCH color appears more vivid. The HSL output represents the sRGB-clamped version.')} />
          <li set:html={t(locale, 'pages.oklchToHsl.gamutLi2', '<strong class="text-ink">Alpha Preservation:</strong> An OKLCH value with alpha converts to <code class="text-ink">hsla(h, s%, l%, a)</code> with the alpha channel intact.')} />
        </ul>
      </section>

      <!-- 6. FAQ -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faqTitle', 'Frequently Asked Questions')}</h2>
        <div class="space-y-3 font-mono text-xs">
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faq1Question', 'Why do I need HSL if I have OKLCH?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.oklchToHsl.faq1Answer', 'Legacy tools — email clients, older CSS preprocessors, native apps, and some design tools — only understand HSL. Converting OKLCH to HSL ensures compatibility with these tools.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faq2Question', 'Is the OKLCH to HSL conversion lossy?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.oklchToHsl.faq2Answer', 'For sRGB colors, the conversion is lossless. For Display-P3 colors, clamping to sRGB is a lossy step. The OKLCH original remains the source of truth.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faq3Question', 'Can I use OKLCH alpha in hsla()?')}</h3>
            <p class="text-body leading-relaxed" set:html={t(locale, 'pages.oklchToHsl.faq3Answer', 'Yes. <code class="text-ink">oklch(62.3% 0.188 259.8 / 0.5)</code> converts to <code class="text-ink">hsla(217, 91%, 60%, 0.5)</code> — the alpha channel is preserved.')} />
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faq4Question', 'What happens with out-of-gamut colors?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.oklchToHsl.faq4Answer', 'The engine clamps chroma to the nearest in-gamut value while preserving hue. You will see a gamut badge indicating the color was clamped.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.oklchToHsl.faq5Question', 'How do I use HSL values in email templates?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.oklchToHsl.faq5Answer', 'Many email clients only support HSL or HEX. Use the HSL output directly in your inline styles — it will render consistently across email clients.')}
            </p>
          </div>
        </div>
      </section>

      <!-- 7. Related Tools -->
      <RelatedTools currentPath="/oklch-to-hsl" locale={locale} />

      <!-- 8. Learn Link -->
      <div class="pt-4 border-t border-hairline">
        <a href={buildLocalizedPath('/learn/what-is-oklch', locale)} class="text-xs font-mono text-accent-text hover:text-ink transition-colors">
          {t(locale, 'pages.oklchToHsl.learnMore', 'Learn more about OKLCH →')}
        </a>
      </div>
    </div>
  </div>
</AppLayout>
