---
import AppLayout from '../layouts/AppLayout.astro';
import PaletteGeneratorIsland from '../components/generator/PaletteGeneratorIsland';
import { getNavItemByPath } from '../config/navigation';

const navItem = getNavItemByPath('/oklch-color-palette-generator');
const seo = navItem?.seo || {
  title: 'OKLCH Color Palette Generator | 50-950 Scales & Harmonies',
  metaDescription: 'Generate perceptually uniform 50-950 color scales and harmonious color palettes using OKLCH color space with automatic gamut-safe chroma clamping.',
  h1: 'OKLCH Color Palette Generator',
  keywords: ['oklch palette generator', 'color scale generator 50-950', 'oklch harmonies', 'tailwind v4 color scale generator'],
  schemaType: 'WebApplication',
};
---

<AppLayout
  title={seo.title}
  description={seo.metaDescription}
  keywords={seo.keywords}
  canonicalPath="/oklch-color-palette-generator"
  schemaType={seo.schemaType}
>
  <div class="max-w-6xl mx-auto px-4 py-6 md:py-8 space-y-10">
    <!-- Header -->
    <div class="space-y-2">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#f5f5f5]">
        {seo.h1}
      </h1>
      <p class="text-xs md:text-sm font-mono text-[#a3a3a3]">
        Input any base color to automatically calculate an accessible 50–950 shade scale with optical lightness uniformity and gamut-safe chroma clipping.
      </p>
    </div>

    <!-- Above-The-Fold Interactive Tool -->
    <section aria-label="OKLCH Color Palette Generator Tool">
      <PaletteGeneratorIsland client:load />
    </section>

    <!-- Unique SEO Content Below The Fold -->
    <div class="space-y-10 pt-8 border-t border-[#1f1f1f]">
      <!-- 1. The Science of OKLCH Scale Generation -->
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-[#f5f5f5]">
          How Our Perceptual Scale Generator Works
        </h2>
        <p class="text-xs font-mono text-[#a3a3a3] leading-relaxed">
          Traditional palette generators blindly interpolate HEX or RGB values, causing midtones to look muddy, hues to shift unexpectedly, and highlights to lose color purity. In contrast, our generator works directly within the 3D cylindrical coordinates of the OKLCH color space:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 font-mono text-xs">
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4 space-y-2">
            <span class="text-[#06b6d4] font-bold block">1. Target Lightness Curve</span>
            <p class="text-[#a3a3a3]">
              Maps lightness across 11 mathematically balanced steps from 97% (step 50) down to 13% (step 950), maintaining even visual steps between shades.
            </p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4 space-y-2">
            <span class="text-[#22c55e] font-bold block">2. Gamut-Safe Chroma Clamping</span>
            <p class="text-[#a3a3a3]">
              Calculates the maximum possible chroma allowed within the sRGB and Display-P3 gamuts for every individual lightness level, preventing harsh clipping artifacts.
            </p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4 space-y-2">
            <span class="text-[#f59e0b] font-bold block">3. Hue Constancy</span>
            <p class="text-[#a3a3a3]">
              Locks the hue angle exactly across all shade steps, eliminating the notorious "purple turning into pinkish-gray" bug seen in RGB generators.
            </p>
          </div>
        </div>
      </section>

      <!-- 2. Color Harmonies Explanation -->
      <section class="space-y-3 bg-[#141414] border border-[#262626] rounded-xl p-6">
        <h2 class="text-base font-semibold text-[#f5f5f5]">
          Calculating Harmonies via Cylindrical Hue Angles
        </h2>
        <p class="text-xs font-mono text-[#a3a3a3] leading-relaxed">
          Because OKLCH organizes colors along a continuous 360-degree cylindrical circle, generating complementary, triadic, and analogous palettes is achieved by exact mathematical angle rotations while preserving lightness and chroma constancy:
        </p>
        <ul class="space-y-2 text-xs font-mono text-[#a3a3a3] list-disc list-inside">
          <li><strong>Complementary:</strong> Hue angle + 180° for maximum visual contrast.</li>
          <li><strong>Triadic:</strong> Hue angles ± 120° for vibrant, balanced triad schemes.</li>
          <li><strong>Analogous:</strong> Hue angles ± 30° for smooth, adjacent gradients and tranquil UI accents.</li>
        </ul>
      </section>

      <!-- 3. FAQ -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-[#f5f5f5]">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3 font-mono text-xs">
          <div class="bg-[#141414] border border-[#262626] rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-[#f5f5f5]">Can I export the generated scale directly into Tailwind CSS v4?</h3>
            <p class="text-[#a3a3a3]">
              Yes! Click "Fill Role with Scale" above to save the entire 50–950 set into your chosen token role (e.g. <code class="text-white">--color-primary-*</code>). Then visit the Export page to copy your complete Tailwind v4 <code class="text-white">@theme</code> block.
            </p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-[#f5f5f5]">Why are extreme light and dark shades lower in chroma?</h3>
            <p class="text-[#a3a3a3]">
              In human color perception and physics, as colors approach pure white (100% Lightness) or pure black (0% Lightness), the gamut triangle narrows to a point. Naturally tapering chroma at steps 50, 100, 900, and 950 produces clean, sophisticated UI tokens rather than harsh neon pastels.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</AppLayout>
