---
import AppLayout from '../../layouts/AppLayout.astro';
import { PALETTES, type PaletteItem } from '../../data/palettes';
import {
  SHADE_STEPS,
  formatOklch,
  getWcagContrast,
  oklchToRgbString,
  oklchToHslString,
} from '../../utils/color';
import { buildLocalizedPath, type LocaleCode } from '../../i18n/config';
import PaletteDetailIsland from '../../components/palettes/PaletteDetailIsland';

export function getStaticPaths() {
  return PALETTES.map((palette) => ({
    params: { slug: palette.slug },
    props: { palette },
  }));
}

interface Props {
  palette: PaletteItem;
  locale?: LocaleCode;
}

const { palette, locale = 'en' } = Astro.props;

/** Compress consecutive shade steps into ranges: [500,600,700,800,900,950] → "500-950". */
function formatStepRange(steps: number[]): string {
  if (steps.length === 0) return 'none';
  if (steps.length === 1) return String(steps[0]);
  const sorted = [...steps].sort((a, b) => a - b);
  // Check if fully consecutive
  const consecutive = sorted.every((v, i) => i === 0 || v === sorted[i - 1] + 100 || (i > 0 && sorted[i - 1] === 900 && v === 950));
  if (consecutive) return `${sorted[0]}-${sorted[sorted.length - 1]}`;
  return sorted.join(', ');
}

const aaWhiteSteps: number[] = [];
const aaBlackSteps: number[] = [];
for (const step of SHADE_STEPS) {
  const c = palette.shades[step];
  if (getWcagContrast(c.hex, '#ffffff') >= 4.5) aaWhiteSteps.push(step);
  if (getWcagContrast(c.hex, '#000000') >= 4.5) aaBlackSteps.push(step);
}

const hue = Math.round(palette.baseColor.h);
const aaWhite = formatStepRange(aaWhiteSteps);
const aaBlack = formatStepRange(aaBlackSteps);

const title = `${palette.name} OKLCH Palette - 50-950, HEX & Tailwind v4`;
const description = `${palette.name} OKLCH palette at hue ${hue}. Steps ${aaWhite} pass WCAG AA on white, ${aaBlack} on black. Copy oklch() or save as Tailwind v4 tokens.`;

// Unique intro built from real data: character (from data), hue, computed contrast steps.
const midStep = palette.shades[500];
const midHex = midStep.hex;
const intro = `${palette.description} The scale is anchored at hue ${hue} in OKLCH, so every step keeps the same hue while lightness moves in perceptually even steps from 50 to 950. The 500 step (${midHex}) is your base color. Shades ${aaWhite} pass WCAG 2.1 AA against white and shades ${aaBlack} pass against black, so use the light end for backgrounds and the dark end for text on light surfaces (or vice versa). Each value is copy-ready as oklch(), HEX, RGB or HSL.`;

// Related palettes: same category first, then fill with others (deterministic order).
const sameCategory = PALETTES.filter((p) => p.slug !== palette.slug && p.category === palette.category);
const otherPalettes = PALETTES.filter((p) => p.slug !== palette.slug && p.category !== palette.category);
const relatedPalettes = [...sameCategory, ...otherPalettes].slice(0, 4);
---

<AppLayout
  title={title}
  description={description}
  canonicalPath={`/oklch-colors/${palette.slug}`}
  schemaType="CollectionPage"
  locale={locale}
>
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-mute" aria-label="Breadcrumb">
      <a href={buildLocalizedPath('/', locale)} class="hover:text-ink">Home</a>
      <span>/</span>
      <a href={buildLocalizedPath('/oklch-colors', locale)} class="hover:text-ink">Palettes</a>
      <span>/</span>
      <span class="text-ink">{palette.name}</span>
    </nav>

    <!-- Header & Hero -->
    <div class="space-y-3">
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
          {palette.name}
        </h1>
        <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-canvas-raised border border-hairline text-body">
          {palette.categoryLabel}
        </span>
      </div>
      <p class="text-xs md:text-sm font-mono text-body max-w-2xl leading-relaxed">
        {palette.description}
      </p>
    </div>

    <!-- Unique data-driven intro (SEO content) -->
    <section class="max-w-3xl">
      <h2 class="text-base font-semibold text-ink mb-2">About the {palette.name} palette</h2>
      <p class="text-sm text-body leading-relaxed">{intro}</p>
    </section>

    <!-- The scale, as large cards with their own copy / cart actions -->
    <section class="space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-mute">
        <span>Shade Steps</span>
        <span>Copy a value, or save it to a variable of your own</span>
      </div>
      <PaletteDetailIsland
        client:load
        shades={palette.shades}
        paletteName={palette.name}
        paletteSlug={palette.slug}
      />
    </section>

    <!-- Detailed 11-step Table Breakdown -->
    <section class="space-y-4">
      <h2 class="text-base font-semibold text-ink">
        Shade Step Breakdown (50 to 950)
      </h2>

      <div class="bg-canvas-card border border-hairline rounded-xl overflow-hidden shadow-lg">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-canvas-elevated border-b border-hairline text-mute uppercase tracking-wider text-[11px]">
              <tr>
                <th class="p-3">Swatch</th>
                <th class="p-3">Shade Step</th>
                <th class="p-3">OKLCH CSS Value</th>
                <th class="p-3">sRGB Fallback</th>
                <th class="p-3">RGB</th>
                <th class="p-3">HSL</th>
                <th class="p-3">WCAG on Black</th>
                <th class="p-3">WCAG on White</th>
                <th class="p-3 text-right">Gamut</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {SHADE_STEPS.map((step) => {
                const color = palette.shades[step];
                const oklchCss = formatOklch(color);
                const contrastBlack = getWcagContrast(color.hex, '#000000');
                const contrastWhite = getWcagContrast(color.hex, '#ffffff');

                return (
                  <tr class="hover:bg-canvas-elevated transition-colors">
                    <td class="p-3">
                      <div
                        class="w-7 h-7 rounded border border-white/20 shadow-sm"
                        style={`background-color: ${oklchCss};`}
                      />
                    </td>
                    <td class="p-3 font-bold text-ink">{step}</td>
                    <td class="p-3 text-copy-success">{oklchCss}</td>
                    <td class="p-3 text-body">{color.hex}</td>
                    <td class="p-3 text-body">{oklchToRgbString(color)}</td>
                    <td class="p-3 text-body">{oklchToHslString(color)}</td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastBlack >= 4.5 ? 'text-copy-success' : 'text-mute'}`}>
                        {contrastBlack}:1
                      </span>
                    </td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastWhite >= 4.5 ? 'text-copy-success' : 'text-mute'}`}>
                        {contrastWhite}:1
                      </span>
                    </td>
                    <td class="p-3 text-right">
                      {color.inP3 && !color.inSRGB ? (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-gamut-p3/20 text-gamut-p3 font-bold">
                          Display-P3
                        </span>
                      ) : (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-canvas-elevated text-mute">
                          sRGB
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tailwind v4 @theme Code Snippet for this Palette -->
    <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-ink">
          Tailwind v4 @theme Snippet for {palette.name}
        </h2>
        <span class="text-[11px] font-mono text-mute">Copy into global.css</span>
      </div>

      <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
        <code>@theme &#123;{'\n'}{SHADE_STEPS.map((step) => `  --color-${palette.slug}-${step}: ${formatOklch(palette.shades[step])};\n`).join('')}&#125;</code></pre>
    </section>

    <!-- Converters -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-ink">Convert {palette.name} shades</h2>
      <p class="text-sm text-body max-w-3xl leading-relaxed">
        Working with these shades in another format? Use the matching converter — the same
        values you see above, converted instantly with live gamut detection.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href={buildLocalizedPath('/hex-to-oklch', locale)} class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors text-sm font-semibold text-ink">
          HEX to OKLCH converter
        </a>
        <a href={buildLocalizedPath('/oklch-to-hex', locale)} class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors text-sm font-semibold text-ink">
          OKLCH to HEX converter
        </a>
        <a href={buildLocalizedPath('/rgb-to-oklch', locale)} class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors text-sm font-semibold text-ink">
          RGB to OKLCH converter
        </a>
        <a href={buildLocalizedPath('/oklch-color-palette-generator', locale)} class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors text-sm font-semibold text-ink">
          Build your own palette
        </a>
      </div>
    </section>

    <!-- Related palettes -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-ink">Related palettes</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {relatedPalettes.map((related) => (
          <a
            href={buildLocalizedPath(`/oklch-colors/${related.slug}`, locale)}
            class="block p-4 rounded-xl bg-canvas-card border border-hairline hover:bg-canvas-elevated transition-colors space-y-2"
          >
            <span class="text-sm font-semibold text-ink block">{related.name}</span>
            <span
              class="block h-6 rounded border border-white/20"
              style={`background-color: ${formatOklch(related.shades[500])};`}
            />
            <span class="text-xs font-mono text-body">{related.categoryLabel}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</AppLayout>
