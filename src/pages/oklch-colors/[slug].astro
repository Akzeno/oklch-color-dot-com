---
import AppLayout from '../../layouts/AppLayout.astro';
import { PALETTES, type PaletteItem } from '../../data/palettes';
import { SHADE_STEPS, formatOklch, getWcagContrast } from '../../utils/color';
import SwatchStripIsland from '../../components/palettes/SwatchStripIsland';

export function getStaticPaths() {
  return PALETTES.map((palette) => ({
    params: { slug: palette.slug },
    props: { palette },
  }));
}

interface Props {
  palette: PaletteItem;
}

const { palette } = Astro.props;

const title = `${palette.name} OKLCH Palette | 50–950 Color Scale`;
const description = `Explore the ${palette.name} OKLCH color palette with 11 perceptually uniform shade steps (50 to 950). Copy individual CSS values or add swatches to your design token cart.`;
---

<AppLayout
  title={title}
  description={description}
  canonicalPath={`/oklch-colors/${palette.slug}`}
  schemaType="CollectionPage"
>
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-[#737373]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#f5f5f5]">Home</a>
      <span>/</span>
      <a href="/oklch-colors" class="hover:text-[#f5f5f5]">Palettes</a>
      <span>/</span>
      <span class="text-[#f5f5f5]">{palette.name}</span>
    </nav>

    <!-- Header & Hero -->
    <div class="space-y-3">
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[#f5f5f5]">
          {palette.name}
        </h1>
        <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-[#171717] border border-[#262626] text-[#a3a3a3]">
          {palette.categoryLabel}
        </span>
      </div>
      <p class="text-xs md:text-sm font-mono text-[#a3a3a3] max-w-2xl leading-relaxed">
        {palette.description}
      </p>
    </div>

    <!-- Contiguous Hero Swatch Strip -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-[#737373]">
        <span>Hero Swatch Bar</span>
        <span>Click any swatch to copy value and add to cart</span>
      </div>
      <SwatchStripIsland client:load shades={palette.shades} paletteName={palette.name} />
    </div>

    <!-- Detailed 11-step Table Breakdown -->
    <section class="space-y-4">
      <h2 class="text-base font-semibold text-[#f5f5f5]">
        Shade Step Breakdown (50 to 950)
      </h2>

      <div class="bg-[#141414] border border-[#262626] rounded-xl overflow-hidden shadow-lg">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-[#181818] border-b border-[#262626] text-[#737373] uppercase tracking-wider text-[11px]">
              <tr>
                <th class="p-3">Swatch</th>
                <th class="p-3">Shade Step</th>
                <th class="p-3">OKLCH CSS Value</th>
                <th class="p-3">sRGB Fallback</th>
                <th class="p-3">WCAG on Black</th>
                <th class="p-3">WCAG on White</th>
                <th class="p-3 text-right">Gamut</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1f1f1f]">
              {SHADE_STEPS.map((step) => {
                const color = palette.shades[step];
                const oklchCss = formatOklch(color);
                const contrastBlack = getWcagContrast(color.hex, '#000000');
                const contrastWhite = getWcagContrast(color.hex, '#ffffff');

                return (
                  <tr class="hover:bg-[#1a1a1a] transition-colors">
                    <td class="p-3">
                      <div
                        class="w-7 h-7 rounded border border-white/20 shadow-sm"
                        style={`background-color: ${oklchCss};`}
                      />
                    </td>
                    <td class="p-3 font-bold text-[#f5f5f5]">{step}</td>
                    <td class="p-3 text-[#86efac]">{oklchCss}</td>
                    <td class="p-3 text-[#a3a3a3]">{color.hex}</td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastBlack >= 4.5 ? 'text-[#22c55e]' : 'text-[#737373]'}`}>
                        {contrastBlack}:1
                      </span>
                    </td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastWhite >= 4.5 ? 'text-[#22c55e]' : 'text-[#737373]'}`}>
                        {contrastWhite}:1
                      </span>
                    </td>
                    <td class="p-3 text-right">
                      {color.inP3 && !color.inSRGB ? (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-[#06b6d4]/20 text-[#06b6d4] font-bold">
                          Display-P3
                        </span>
                      ) : (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-[#1f1f1f] text-[#737373]">
                          sRGB
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tailwind v4 @theme Code Snippet for this Palette -->
    <section class="space-y-3 bg-[#141414] border border-[#262626] rounded-xl p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-[#f5f5f5]">
          Tailwind v4 @theme Snippet for {palette.name}
        </h2>
        <span class="text-[11px] font-mono text-[#737373]">Copy into global.css</span>
      </div>

      <pre class="bg-[#0a0a0a] border border-[#262626] p-4 rounded-lg font-mono text-xs text-[#a3a3a3] overflow-x-auto">
<code>@theme &#123;
{SHADE_STEPS.map((step) => `  --color-${palette.slug}-${step}: ${formatOklch(palette.shades[step])};\n`).join('')}&#125;</code></pre>
    </section>
  </div>
</AppLayout>
