---
import AppLayout from '../../layouts/AppLayout.astro';
import { PALETTES, type PaletteItem } from '../../data/palettes';
import { SHADE_STEPS, formatOklch, getWcagContrast } from '../../utils/color';
import PaletteDetailIsland from '../../components/palettes/PaletteDetailIsland';

export function getStaticPaths() {
  return PALETTES.map((palette) => ({
    params: { slug: palette.slug },
    props: { palette },
  }));
}

interface Props {
  palette: PaletteItem;
}

const { palette } = Astro.props;

/** Compress consecutive shade steps into ranges: [500,600,700,800,900,950] → "500-950". */
function formatStepRange(steps: number[]): string {
  if (steps.length === 0) return 'none';
  if (steps.length === 1) return String(steps[0]);
  const sorted = [...steps].sort((a, b) => a - b);
  // Check if fully consecutive
  const consecutive = sorted.every((v, i) => i === 0 || v === sorted[i - 1] + 100 || (i > 0 && sorted[i - 1] === 900 && v === 950));
  if (consecutive) return `${sorted[0]}-${sorted[sorted.length - 1]}`;
  return sorted.join(', ');
}

const aaWhiteSteps: number[] = [];
const aaBlackSteps: number[] = [];
for (const step of SHADE_STEPS) {
  const c = palette.shades[step];
  if (getWcagContrast(c.hex, '#ffffff') >= 4.5) aaWhiteSteps.push(step);
  if (getWcagContrast(c.hex, '#000000') >= 4.5) aaBlackSteps.push(step);
}

const hue = Math.round(palette.baseColor.h);
const aaWhite = formatStepRange(aaWhiteSteps);
const aaBlack = formatStepRange(aaBlackSteps);

const title = `${palette.name} OKLCH Palette - 50-950, HEX & Tailwind v4`;
const description = `${palette.name} OKLCH palette at hue ${hue}. Steps ${aaWhite} pass WCAG AA on white, ${aaBlack} on black. Copy oklch() or save as Tailwind v4 tokens.`;
---

<AppLayout
  title={title}
  description={description}
  canonicalPath={`/oklch-colors/${palette.slug}`}
  schemaType="CollectionPage"
>
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-mute" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a>
      <span>/</span>
      <a href="/oklch-colors" class="hover:text-ink">Palettes</a>
      <span>/</span>
      <span class="text-ink">{palette.name}</span>
    </nav>

    <!-- Header & Hero -->
    <div class="space-y-3">
      <div class="flex items-center gap-2.5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
          {palette.name}
        </h1>
        <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-canvas-raised border border-hairline text-body">
          {palette.categoryLabel}
        </span>
      </div>
      <p class="text-xs md:text-sm font-mono text-body max-w-2xl leading-relaxed">
        {palette.description}
      </p>
    </div>

    <!-- The scale, as large cards with their own copy / cart actions -->
    <section class="space-y-2">
      <div class="flex items-center justify-between text-xs font-mono text-mute">
        <span>Shade Steps</span>
        <span>Copy a value, or save it to a variable of your own</span>
      </div>
      <PaletteDetailIsland
        client:load
        shades={palette.shades}
        paletteName={palette.name}
        paletteSlug={palette.slug}
      />
    </section>

    <!-- Detailed 11-step Table Breakdown -->
    <section class="space-y-4">
      <h2 class="text-base font-semibold text-ink">
        Shade Step Breakdown (50 to 950)
      </h2>

      <div class="bg-canvas-card border border-hairline rounded-xl overflow-hidden shadow-lg">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-canvas-elevated border-b border-hairline text-mute uppercase tracking-wider text-[11px]">
              <tr>
                <th class="p-3">Swatch</th>
                <th class="p-3">Shade Step</th>
                <th class="p-3">OKLCH CSS Value</th>
                <th class="p-3">sRGB Fallback</th>
                <th class="p-3">WCAG on Black</th>
                <th class="p-3">WCAG on White</th>
                <th class="p-3 text-right">Gamut</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {SHADE_STEPS.map((step) => {
                const color = palette.shades[step];
                const oklchCss = formatOklch(color);
                const contrastBlack = getWcagContrast(color.hex, '#000000');
                const contrastWhite = getWcagContrast(color.hex, '#ffffff');

                return (
                  <tr class="hover:bg-canvas-elevated transition-colors">
                    <td class="p-3">
                      <div
                        class="w-7 h-7 rounded border border-white/20 shadow-sm"
                        style={`background-color: ${oklchCss};`}
                      />
                    </td>
                    <td class="p-3 font-bold text-ink">{step}</td>
                    <td class="p-3 text-copy-success">{oklchCss}</td>
                    <td class="p-3 text-body">{color.hex}</td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastBlack >= 4.5 ? 'text-copy-success' : 'text-mute'}`}>
                        {contrastBlack}:1
                      </span>
                    </td>
                    <td class="p-3">
                      <span class={`font-semibold ${contrastWhite >= 4.5 ? 'text-copy-success' : 'text-mute'}`}>
                        {contrastWhite}:1
                      </span>
                    </td>
                    <td class="p-3 text-right">
                      {color.inP3 && !color.inSRGB ? (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-gamut-p3/20 text-gamut-p3 font-bold">
                          Display-P3
                        </span>
                      ) : (
                        <span class="px-2 py-0.5 rounded text-[10px] bg-canvas-elevated text-mute">
                          sRGB
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tailwind v4 @theme Code Snippet for this Palette -->
    <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-ink">
          Tailwind v4 @theme Snippet for {palette.name}
        </h2>
        <span class="text-[11px] font-mono text-mute">Copy into global.css</span>
      </div>

      <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
        <code>@theme &#123;{'\n'}{SHADE_STEPS.map((step) => `  --color-${palette.slug}-${step}: ${formatOklch(palette.shades[step])};\n`).join('')}&#125;</code></pre>
    </section>
  </div>
</AppLayout>
