---
import AppLayout from '../../layouts/AppLayout.astro';
import PaletteCard from '../../components/palettes/PaletteCard.astro';
import RelatedTools from '../../components/common/RelatedTools.astro';
import { PALETTES, CATEGORIES } from '../../data/palettes';
import { localizedSeo } from '../../i18n/seo';
import { buildLocalizedPath, type LocaleCode } from '../../i18n/config';
import { t } from '../../i18n/translations';

interface Props {
  locale?: LocaleCode;
}
const { locale = 'en' } = Astro.props;

const seo = localizedSeo('/oklch-colors', locale, {
  title: 'OKLCH Color Palettes - 16 Scales, 50-950, Tailwind v4',
  metaDescription:
    'Browse 16 curated OKLCH color palettes, each an 11-step 50-950 scale. Copy any oklch() value or save shades as Tailwind CSS v4 design tokens.',
  h1: 'OKLCH Color Palettes',
  keywords: ['oklch color palettes', 'oklch colors', 'radix oklch', 'tailwind v4 palettes', 'accessible color scales'],
  schemaType: 'CollectionPage',
});
---

<AppLayout
  title={seo.title}
  description={seo.metaDescription}
  keywords={seo.keywords}
  canonicalPath="/oklch-colors"
  schemaType={seo.schemaType}
  locale={locale}
>
  <div class="max-w-6xl mx-auto px-4 py-6 md:py-8 space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
          {seo.h1}
        </h1>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.palettes.intro', 'Curated 11-step (50–950) OKLCH color scales. Open any palette to copy individual values or save them into your design token cart.')}
        </p>
      </div>

      <!-- Quick Stats Pill -->
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-canvas-card border border-hairline text-body">
          {t(locale, 'pages.palettes.stats', '{count} palettes • 11 shades each').replace('{count}', String(PALETTES.length))}
        </span>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-2 no-scrollbar border-b border-hairline">
      {CATEGORIES.map((cat) => (
        <a
          href={cat.id === 'all' ? buildLocalizedPath('/oklch-colors', locale) : buildLocalizedPath(`/oklch-colors#${cat.id}`, locale)}
          class="px-3 py-1.5 rounded-full text-xs font-mono bg-canvas-card hover:bg-canvas-elevated text-body hover:text-ink border border-hairline transition-colors whitespace-nowrap"
        >
          {t(locale, `pages.paletteCategories.${cat.id}`, cat.label)}
        </a>
      ))}
    </div>

    <!-- Palette Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      {PALETTES.map((palette) => (
        <div id={palette.category}>
          <PaletteCard palette={palette} locale={locale} />
        </div>
      ))}
    </div>

    <!-- Educational Content -->
    <div class="space-y-6 pt-6 border-t border-hairline">
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-6">
        <h2 class="text-base font-semibold text-ink">
          {t(locale, 'pages.palettes.whatTitle', 'What are OKLCH Colors?')}
        </h2>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.palettes.whatBody', 'OKLCH colors are defined in a perceptually uniform color space that separates lightness (L), chroma (C), and hue (H). Unlike HSL, where 50% lightness looks completely different for yellow versus blue, OKLCH guarantees that equal lightness values look equally bright across all hues. This makes OKLCH ideal for building accessible, predictable color systems.')}
        </p>
      </section>

      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-6">
        <h2 class="text-base font-semibold text-ink">
          {t(locale, 'pages.palettes.scaleTitle', 'How the 11-Step 50-950 Scale Works')}
        </h2>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.palettes.scaleBody1', 'Each palette is an 11-step scale from step 50 (lightest, near-white) to step 950 (darkest, near-black). The steps follow a perceptually uniform lightness curve: 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950. Step 500 is the base color. Chroma is automatically tapered at extreme light and dark steps to keep every shade gamut-safe and visually clean.')}
        </p>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.palettes.scaleBody2', "This is the same scale used by Tailwind CSS v4's default palette and by Radix Colors. It gives you a complete set of tints and shades for any UI role — backgrounds, borders, text, and interactive states.")}
        </p>
      </section>

      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-6">
        <h2 class="text-base font-semibold text-ink">
          {t(locale, 'pages.palettes.tailwindTitle', 'How to Use a Palette in Tailwind CSS v4')}
        </h2>
        <p class="text-xs md:text-sm font-mono text-body" set:html={t(locale, 'pages.palettes.tailwindBody1', 'Open any palette page and copy the Tailwind v4 <code class="text-ink">@theme</code> snippet. Paste it into your global CSS file:')} />
        <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto"><code>{t(locale, 'pages.palettes.tailwindCode', '@import "tailwindcss";\n\n@theme {\n  --color-brand-50: oklch(0.965 0.015 265);\n  --color-brand-100: oklch(0.935 0.028 265);\n  /* ... all 11 steps ... */\n  --color-brand-950: oklch(0.22 0.06 265);\n}')}</code></pre>
        <p class="text-xs md:text-sm font-mono text-body" set:html={t(locale, 'pages.palettes.tailwindBody2', 'Tailwind v4 automatically generates utilities for every step: <code class="text-ink">bg-brand-50</code>, <code class="text-ink">text-brand-500</code>, <code class="text-ink">border-brand-200</code>, and so on.')} />
      </section>

      <!-- Related Tools -->
      <RelatedTools currentPath="/oklch-colors" locale={locale} />

      <!-- Learn Link -->
      <div class="pt-4 border-t border-hairline">
        <a href={buildLocalizedPath('/learn/what-is-oklch', locale)} class="text-xs font-mono text-accent-text hover:text-ink transition-colors">
          {t(locale, 'pages.palettes.learnMore', 'Learn more about OKLCH →')}
        </a>
      </div>
    </div>
  </div>
</AppLayout>
