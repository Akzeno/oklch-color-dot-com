---
import AppLayout from '../layouts/AppLayout.astro';
import ConverterIsland from '../components/converters/ConverterIsland';
import RelatedTools from '../components/common/RelatedTools.astro';
import { getBuildTimeColorTable } from '../utils/seoTables';
import { parseAnyToOklch, formatOklch } from '../utils/color';
import { localizedSeo } from '../i18n/seo';
import { buildLocalizedPath, type LocaleCode } from '../i18n/config';
import { t } from '../i18n/translations';

interface Props {
  locale?: LocaleCode;
}
const { locale = 'en' } = Astro.props;

const seo = localizedSeo('/rgb-to-oklch', locale, {
  title: 'RGB to OKLCH Converter - Free CSS oklch() Tool',
  metaDescription:
    'Convert rgb() and rgba() colors to CSS oklch() instantly. Free RGB to OKLCH converter with live gamut boundary checks.',
  h1: 'RGB to OKLCH Converter',
  keywords: ['rgb to oklch', 'convert rgb to oklch', 'srgb to oklch'],
  schemaType: 'WebApplication',
});

const examplesTable = getBuildTimeColorTable('rgb-to-oklch');

const sampleColor = parseAnyToOklch('#3b82f6');
const sampleOklch = sampleColor ? formatOklch(sampleColor) : 'oklch(62.3% 0.188 259.8)';
---

<AppLayout
  title={seo.title}
  description={seo.metaDescription}
  keywords={seo.keywords}
  canonicalPath="/rgb-to-oklch"
  schemaType={seo.schemaType}
  locale={locale}
>
  <div class="max-w-5xl mx-auto px-4 py-6 md:py-8 space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>
      <p class="text-xs md:text-sm font-mono text-body" set:html={t(locale, 'pages.rgbToOklch.subtitle', 'Convert <code class="text-ink">rgb(r, g, b)</code> and <code class="text-ink">rgba(r, g, b, a)</code> into CSS OKLCH format with live gamut boundary checks.')} />
    </div>

    <section aria-label={t(locale, 'pages.rgbToOklch.toolAriaLabel', 'RGB to OKLCH Converter Tool')}>
      <ConverterIsland client:load initialMode="rgb-to-oklch" locale={locale} />
    </section>

    <div class="space-y-10 pt-8 border-t border-hairline">
      <!-- 1. Intro -->
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.rgbToOklch.whyTitle', 'Why Convert RGB to OKLCH?')}</h2>
        <p class="text-xs md:text-sm font-mono text-body">
          {t(locale, 'pages.rgbToOklch.whyBody', 'RGB mixes red, green, and blue light components, but it is completely non-linear with respect to human vision. Mixing equal parts RGB produces irregular visual steps. By converting into OKLCH, you gain access to linear perceptual lightness, enabling harmonious tints and shades for modern design systems.')}
        </p>
      </section>

      <!-- 2. How to Convert -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-6">
        <h2 class="text-base font-semibold text-ink">{t(locale, 'pages.rgbToOklch.howTitle', 'How to Convert RGB to OKLCH')}</h2>
        <ol class="space-y-2 text-xs font-mono text-body list-decimal list-inside">
          <li set:html={t(locale, 'pages.rgbToOklch.step1', 'Paste any <code class="text-ink">rgb()</code> or <code class="text-ink">rgba()</code> value (e.g. <code class="text-ink">rgb(59, 130, 246)</code>) into the input field above.')} />
          <li>{t(locale, 'pages.rgbToOklch.step2', 'Our engine normalizes the 0-255 channels to 0-1, applies gamma decoding to get linear RGB, then transforms through the Oklab LMS cone response matrices.')}</li>
          <li>{t(locale, 'pages.rgbToOklch.step3', 'The result is a perceptually uniform OKLCH value with exact Lightness, Chroma, and Hue.')}</li>
        </ol>
        <p class="text-xs md:text-sm font-mono text-body pt-2" set:html={t(locale, 'pages.rgbToOklch.mathPath', '<strong class="text-ink">The math path:</strong> RGB (0-255) → normalized sRGB (0-1) → linear RGB (gamma decode) → Oklab (LMS matrices) → OKLCH (cylindrical transform).')} />
      </section>

      <!-- 3. Reference Table -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.rgbToOklch.tableTitle', 'RGB to OKLCH Reference Values')}</h2>
        <div class="bg-canvas-card border border-hairline rounded-xl overflow-hidden shadow-lg">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-canvas-elevated border-b border-hairline text-mute text-[11px] uppercase">
                <tr>
                  <th class="p-3">{t(locale, 'pages.rgbToOklch.thSwatch', 'Swatch')}</th>
                  <th class="p-3">{t(locale, 'pages.rgbToOklch.thColor', 'Color')}</th>
                  <th class="p-3">{t(locale, 'pages.rgbToOklch.thRgbCode', 'RGB Code')}</th>
                  <th class="p-3">{t(locale, 'pages.rgbToOklch.thOklchValue', 'OKLCH Value')}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                {examplesTable.map((row) => (
                  <tr class="hover:bg-canvas-elevated transition-colors">
                    <td class="p-3">
                      <div class="w-6 h-6 rounded border border-white/20" style={`background-color: ${row.oklch};`} />
                    </td>
                    <td class="p-3 text-ink font-medium">{row.name}</td>
                    <td class="p-3 text-body">{row.rgb}</td>
                    <td class="p-3 text-copy-success">{row.oklch}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 4. CSS Snippet -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5">
        <h2 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.cssTitle', 'Copy-Ready CSS with Progressive Enhancement')}</h2>
        <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
          <code>{t(locale, 'pages.rgbToOklch.cssSnippet', '.alert {\n  color: rgb(239, 68, 68); /* fallback */\n  color: {sample}; /* modern browsers */\n}').replace('{sample}', sampleOklch)}</code></pre>
        <p class="text-xs md:text-sm font-mono text-body pt-2" set:html={t(locale, 'pages.rgbToOklch.themeLabel', '<strong class="text-ink">Tailwind CSS v4 @theme:</strong>')} />
        <pre class="bg-canvas-sunken border border-hairline p-4 rounded-lg font-mono text-xs text-body overflow-x-auto">
          <code>{t(locale, 'pages.rgbToOklch.themeSnippet', '@theme {\n  --color-alert-red: {sample};\n}').replace('{sample}', sampleOklch)}</code></pre>
      </section>

      <!-- 5. Gamut Note -->
      <section class="space-y-3 bg-canvas-card border border-hairline rounded-xl p-5 md:p-6">
        <h2 class="text-base font-semibold text-ink">{t(locale, 'pages.rgbToOklch.gamutTitle', 'Gamut Note: RGB is Always sRGB')}</h2>
        <p class="text-xs md:text-sm font-mono text-body" set:html={t(locale, 'pages.rgbToOklch.gamutBody', 'Standard <code class="text-ink">rgb()</code> values are confined to the sRGB gamut by definition. Converting from RGB to OKLCH is therefore always gamut-safe — the resulting OKLCH value will never exceed sRGB boundaries. However, if you paste a <code class="text-ink">color(display-p3 ...)</code> value, the converter will detect the wider gamut and flag it accordingly.')} />
      </section>

      <!-- 6. FAQ -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faqTitle', 'Frequently Asked Questions')}</h2>
        <div class="space-y-3 font-mono text-xs">
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faq1Q', 'Can I convert rgba() with alpha to OKLCH?')}</h3>
            <p class="text-body leading-relaxed" set:html={t(locale, 'pages.rgbToOklch.faq1A', 'Yes. <code class="text-ink">rgba(59, 130, 246, 0.5)</code> converts to <code class="text-ink">oklch(62.3% 0.188 259.8 / 0.5)</code> — the alpha channel is preserved as a slash parameter.')} />
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faq2Q', 'What is the difference between RGB and OKLCH?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.rgbToOklch.faq2A', 'RGB is a device-dependent additive color model. OKLCH is a perceptually uniform color space where equal lightness values look equally bright. OKLCH makes it far easier to create accessible, consistent color systems.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faq3Q', 'Is RGB to OKLCH conversion reversible?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.rgbToOklch.faq3A', 'Yes, for sRGB colors. Converting RGB → OKLCH → RGB yields the original values. The round-trip is lossless within the sRGB gamut.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faq4Q', 'Do all browsers support oklch()?')}</h3>
            <p class="text-body leading-relaxed">
              {t(locale, 'pages.rgbToOklch.faq4A', 'Yes. oklch() is a Baseline feature available across all modern browsers since May 2023. Chrome, Edge, Safari, and Firefox all support it natively.')}
            </p>
          </div>
          <div class="bg-canvas-card border border-hairline rounded-lg p-4 space-y-1.5">
            <h3 class="text-sm font-semibold text-ink">{t(locale, 'pages.rgbToOklch.faq5Q', 'How do I use OKLCH in Tailwind CSS v4?')}</h3>
            <p class="text-body leading-relaxed" set:html={t(locale, 'pages.rgbToOklch.faq5A', 'Tailwind v4 uses OKLCH for its entire default palette. Define custom colors in your <code class="text-ink">@theme</code> block using <code class="text-ink">--color-{name}: oklch(...)</code> and Tailwind generates utilities automatically.')} />
          </div>
        </div>
      </section>

      <!-- 7. Related Tools -->
      <RelatedTools currentPath="/rgb-to-oklch" locale={locale} />

      <!-- 8. Learn Link -->
      <div class="pt-4 border-t border-hairline">
        <a href={buildLocalizedPath('/learn/what-is-oklch', locale)} class="text-xs font-mono text-accent-text hover:text-ink transition-colors">
          {t(locale, 'pages.rgbToOklch.learnMoreLink', 'Learn more about OKLCH →')}
        </a>
      </div>
    </div>
  </div>
</AppLayout>
