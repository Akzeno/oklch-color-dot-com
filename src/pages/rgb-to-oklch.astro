---
import AppLayout from '../layouts/AppLayout.astro';
import ConverterIsland from '../components/converters/ConverterIsland';
import { getNavItemByPath } from '../config/navigation';
import { getBuildTimeColorTable } from '../utils/seoTables';

const navItem = getNavItemByPath('/rgb-to-oklch');
const seo = navItem?.seo || {
  title: 'RGB to OKLCH Converter | Perceptual Color Space Conversion',
  metaDescription: 'Convert standard sRGB or Display-P3 rgb(...) values into modern OKLCH lightness, chroma, and hue angles.',
  h1: 'RGB to OKLCH Converter',
  keywords: ['rgb to oklch', 'convert rgb to oklch', 'srgb to oklch'],
  schemaType: 'WebApplication',
};

const examplesTable = getBuildTimeColorTable();
---

<AppLayout
  title={seo.title}
  description={seo.metaDescription}
  keywords={seo.keywords}
  canonicalPath="/rgb-to-oklch"
  schemaType={seo.schemaType}
>
  <div class="max-w-5xl mx-auto px-4 py-6 md:py-8 space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">
        {seo.h1}
      </h1>
      <p class="text-xs md:text-sm font-mono text-body">
        Convert <code class="text-ink">rgb(r, g, b)</code> and <code class="text-ink">rgba(r, g, b, a)</code> into CSS OKLCH format with live gamut boundary checks.
      </p>
    </div>

    <section aria-label="RGB to OKLCH Converter Tool">
      <ConverterIsland client:load initialMode="rgb-to-oklch" />
    </section>

    <div class="space-y-10 pt-8 border-t border-hairline">
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-ink">Why Convert RGB to OKLCH?</h2>
        <p class="text-xs font-mono text-body leading-relaxed">
          RGB mixes red, green, and blue light components, but it is completely non-linear with respect to human vision. Mixing equal parts RGB produces irregular visual steps. By converting into OKLCH, you gain access to linear perceptual lightness, enabling harmonious tints and shades for modern design systems.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-lg font-semibold text-ink">RGB to OKLCH Reference Values</h2>
        <div class="bg-canvas-card border border-hairline rounded-xl overflow-hidden shadow-lg">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-canvas-elevated border-b border-hairline text-mute text-[11px] uppercase">
                <tr>
                  <th class="p-3">Swatch</th>
                  <th class="p-3">Color</th>
                  <th class="p-3">RGB Code</th>
                  <th class="p-3">OKLCH Value</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                {examplesTable.slice(0, 10).map((row) => (
                  <tr class="hover:bg-canvas-elevated transition-colors">
                    <td class="p-3">
                      <div class="w-6 h-6 rounded border border-white/20" style={`background-color: ${row.oklch};`} />
                    </td>
                    <td class="p-3 text-ink font-medium">{row.name}</td>
                    <td class="p-3 text-body">{row.hex}</td>
                    <td class="p-3 text-copy-success">{row.oklch}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <div class="pt-4 border-t border-hairline flex items-center gap-4 text-xs font-mono text-mute">
        <a href="/oklch-to-rgb" class="hover:text-ink">OKLCH to RGB Converter →</a>
        <a href="/hex-to-oklch" class="hover:text-ink">HEX to OKLCH Converter →</a>
      </div>
    </div>
  </div>
</AppLayout>
