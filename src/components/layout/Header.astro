---
import CartTriggerButton from '../cart/CartTriggerButton';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { buildLocalizedPath, type LocaleCode } from '../../i18n/config';

interface Props {
  locale?: LocaleCode;
  /** Canonical (unprefixed) path of the current page. */
  currentPath?: string;
  /**
   * Utility pages (404/500, which are noindex and have no localized twins)
   * hide the language switcher — there is nothing to switch to.
   */
  showLanguageSwitcher?: boolean;
}

const { locale = 'en', currentPath = '/', showLanguageSwitcher = true } = Astro.props;
const homeHref = buildLocalizedPath('/', locale);
---

{/*
  Shell header. 56px, hairline bottom, sticky.

  The language switcher is back and this time it points at real pages: every
  locale listed here exists under its /locale/ prefix (see src/pages/[lang]/).
  It sits left of the theme toggle so the right edge keeps its original
  order — theme, cart — that muscle memory depends on.

  The theme toggle has something to switch *to* — see
  `ThemeToggle.astro` and the token overrides in `global.css`.
*/}
<header class="h-14 shrink-0 border-b border-hairline bg-canvas/90 backdrop-blur-md sticky top-0 z-30 px-4 flex items-center justify-between">
  <a href={homeHref} class="flex items-center gap-2.5 text-ink hover:opacity-80 transition-opacity">
    <!-- Brand mark -->
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
      <defs>
        <linearGradient id="logo-gradient-header" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fc7bff" />
          <stop offset="100%" stop-color="#ff930f" />
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="24" height="24" rx="2.4" ry="2.4" fill="url(#logo-gradient-header)" />
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#f6f6f6"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-palette"
        style="overflow: visible;"
      >
        <circle cx="13.5" cy="6.5" r="1" fill="#fafafa" />
        <circle cx="17.5" cy="10.5" r="1" fill="#fafafa" />
        <circle cx="8.5" cy="7.5" r="1" fill="#fafafa" />
        <circle cx="6.5" cy="12.5" r="1" fill="#fafafa" />
        <path
          d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
        />
      </svg>
    </svg>
    <span class="text-card font-semibold tracking-tight">
      oklch<span class="font-normal bg-gradient-to-r from-[#fc7bff] to-[#ff930f] bg-clip-text text-transparent">color</span>
    </span>
  </a>

  <div class="flex items-center gap-1.5">
    {showLanguageSwitcher && <LanguageSwitcher locale={locale} currentPath={currentPath} />}
    <ThemeToggle />
    <CartTriggerButton client:load transition:persist locale={locale} />
  </div>
</header>