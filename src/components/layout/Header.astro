---
import CartTriggerButton from '../cart/CartTriggerButton';
---

{/*
  Shell header. 56px, hairline bottom, sticky.

  REMOVED: the theme toggle and the language switcher.

  Neither was reachable functionality. The toggle set `documentElement
  .light-theme`, a class with no rule anywhere in the stylesheet, so clicking it
  did nothing. The switcher linked to `/es`, `/de` and `/fr` — none of which
  exist, so all three were 404s. Both were controls that looked actionable and
  were not; that is worse than their absence. Reintroduce them when there is a
  theme to switch to and a locale to switch to.
*/}
<header class="h-14 shrink-0 border-b border-hairline bg-canvas/90 backdrop-blur-md sticky top-0 z-30 px-4 flex items-center justify-between">
  <a href="/" class="flex items-center gap-2.5 text-ink hover:opacity-80 transition-opacity">
    <!-- Brand mark. The one place a gradient is allowed: it is identity, not
         state, and it is 24px — too small to bias a colour judgement. -->
    <span
      class="w-6 h-6 rounded-[7px] p-px flex items-center justify-center"
      style="background-image: linear-gradient(135deg, var(--color-gamut-p3), var(--color-copy-success), var(--color-gamut-warning));"
      aria-hidden="true"
    >
      <span class="w-full h-full rounded-[6px] bg-canvas flex items-center justify-center font-mono text-[9px] font-semibold text-ink">
        ok
      </span>
    </span>
    <span class="text-card font-semibold tracking-tight">
      oklch<span class="text-body font-normal">colors</span>
    </span>
  </a>

  <div class="flex items-center gap-2">
    <CartTriggerButton client:load />
  </div>
</header>