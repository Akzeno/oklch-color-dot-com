---
import type { PaletteItem } from '../../data/palettes';
import { SHADE_STEPS } from '../../utils/color';
import SwatchStripIsland from './SwatchStripIsland';

interface Props {
  palette: PaletteItem;
}

const { palette } = Astro.props;
const stepCount = SHADE_STEPS.filter((s) => palette.shades[s]).length;
---

{/*
  Compact, self-contained palette unit: header, swatch bar, action bar.

  The header carries the name and a category pill; the swatch bar is the point
  of the card and gets the space. The action bar lives inside the island so the
  whole card is one hydration boundary — header chrome stays server-rendered,
  everything that needs `clipboard` is client-side.
*/}
<article class="card !p-4 flex flex-col gap-3 hover:border-border-focus transition-colors duration-150">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-card text-ink">
        <a href={`/oklch-colors/${palette.slug}`} class="hover:underline decoration-hairline underline-offset-4">
          {palette.name}
        </a>
      </h3>
      <span class="block mt-0.5 font-mono text-micro text-mute">{palette.categoryLabel}</span>
    </div>
    <span class="pill shrink-0">{stepCount} colours</span>
  </div>

  <SwatchStripIsland
    client:visible
    shades={palette.shades}
    paletteName={palette.name}
    paletteSlug={palette.slug}
  />
</article>