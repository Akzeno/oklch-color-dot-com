---
/**
 * Page frame: the H1, an optional one-line meta row, and the content column.
 *
 * The heading is the largest text on the entire site (24px / 600). That is a
 * deliberate reversal of the usual web scale: on a page whose job is showing
 * colour, the swatches are the hero and the title is a label on the instrument.
 * A 30px bold heading used to fight them.
 *
 *   <PageHeader title="…" meta="…">
 *     <span slot="aside">…</span>   <!-- optional right-aligned control -->
 *   </PageHeader>
 */
interface Props {
  title: string;
  /** One short line, mono, muted. A subtitle — not a description. */
  meta?: string;
  /** Widest column. The preview page needs the room; prose pages do not. */
  width?: 'prose' | 'wide' | 'full';
}

const { title, meta, width = 'prose' } = Astro.props;

const widths = {
  prose: 'max-w-4xl',
  wide: 'max-w-6xl',
  full: 'max-w-[1800px]',
};
---

<div class={`${widths[width]} mx-auto px-4 md:px-6`}>
  <header class="pt-6 md:pt-8 pb-5">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <h1 class="text-display text-ink">{title}</h1>
        {meta && <p class="mt-1.5 font-mono text-label text-mute">{meta}</p>}
      </div>
      <slot name="aside" />
    </div>
  </header>

  <slot />
</div>