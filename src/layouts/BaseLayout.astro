---
import { ClientRouter } from 'astro:transitions';
// Astro's own view-transition keyframes + `prefers-reduced-motion` opt-out.
// The component does not bundle these, so without this import the router swaps
// the DOM with no animation and users who ask for reduced motion still get one.
import 'astro/components/viewtransitions.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonicalPath?: string;
  schemaType?: 'WebApplication' | 'CollectionPage' | 'Article';
}

const {
  title,
  description,
  keywords = ['oklch', 'color picker', 'css oklch', 'tailwind v4 theme', 'color palettes'],
  canonicalPath = Astro.url.pathname,
  schemaType = 'WebApplication',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site || 'https://oklchcolors.com').href;

// WebApplication JSON-LD Schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: 'OKLCH Colors Studio',
  url: canonicalUrl,
  description: description,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      THEME. Runs before anything is painted, so the document is already the
      right colour when the first frame arrives — the alternative is a dark
      flash on every load for every reader whose device is set to light.

      Resolution order: the reader's own stored choice first, then the device.
      Nothing is written back on a first visit, so "no preference recorded"
      keeps tracking the device — if the OS flips at sunset, the site flips
      with it. Only an actual click stores a value, and from that moment the
      device is no longer consulted.

      `is:inline` and untransformed on purpose: this has to be in the served
      HTML, in the head, synchronous, and byte-identical on every page. Being
      identical is also what makes it survive Astro's client-side router —
      `deselectScripts` skips a script whose text it has already executed, so
      after a navigation this block does not run again and the listeners it
      registered the first time are still the live ones.

      Two of those listeners matter:
        · click, delegated on `document` — the toggle button is replaced on
          every navigation, so a listener bound to the element would be dead
          after the first page change. Delegated, there is nothing to rebind.
        · `astro:after-swap` — the router copies the new document's attributes
          onto <html>, which *removes* `data-theme` (the server has no way to
          know it). Without this line the theme would silently reset to dark
          on every client-side navigation. It re-applies in the same task as
          the swap, so no frame of the wrong theme is ever shown.
    -->
    <script is:inline>
      (function () {
        var KEY = 'oklch-theme';
        var root = document.documentElement;

        function systemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }

        function storedTheme() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        }

        function resolve() {
          return storedTheme() || systemTheme();
        }

        function apply(theme) {
          root.setAttribute('data-theme', theme);
        }

        apply(resolve());

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          if (!target.closest('[data-theme-toggle]')) return;
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {
            /* Private mode: the toggle still works, it just won't persist. */
          }
          apply(next);
        });

        document.addEventListener('astro:after-swap', function () {
          apply(resolve());
        });

        var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)');
        if (mq) {
          var onPrefChange = function () {
            if (!storedTheme()) apply(systemTheme());
          };
          if (mq.addEventListener) mq.addEventListener('change', onPrefChange);
          else if (mq.addListener) mq.addListener(onPrefChange);
        }
      })();
    </script>

    <!--
      Client-side router. Without this, every page change is a full document
      load (fresh HTML parse, re-download, re-execute the bundle), which is what
      made moving between pages feel like a hard reload. It intercepts link
      clicks and `navigate()` from `astro:transitions/client`, swaps the DOM in
      place and cross-fades the result.
    -->
    <ClientRouter />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!--
      Geist / Geist Mono lead the stack per DESIGN.md, which uses them to keep
      numbers visually distinct from labels at small sizes. Inter and JetBrains
      Mono remain in the CSS font stack as fallbacks rather than being requested
      here, so a font-CDN hiccup degrades to the platform UI font instead of
      leaving every value unstyled.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink antialiased selection:bg-hairline selection:text-ink">
    <slot />
  </body>
</html>
