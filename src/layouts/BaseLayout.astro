---
import { ClientRouter } from 'astro:transitions';
// Astro's own view-transition keyframes + `prefers-reduced-motion` opt-out.
// The component does not bundle these, so without this import the router swaps
// the DOM with no animation and users who ask for reduced motion still get one.
import 'astro/components/viewtransitions.css';
import '../styles/global.css';
import { getNavItemByPath } from '../config/navigation';
import { ogImagePathFor } from '../utils/ogImage';
import { buildJsonLdGraph } from '../utils/schema';
import { getLocaleConfig, type LocaleCode } from '../i18n/config';
import { localizedSeo } from '../i18n/seo';
import { generateAlternateLinks, getCanonicalPath } from '../i18n/routing';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  /** Locale-independent path (e.g. `/hex-to-oklch`). Localized here. */
  canonicalPath?: string;
  schemaType?: 'WebApplication' | 'CollectionPage' | 'Article';
  /** Set only on the 404 page — utility pages should never be indexed. */
  noindex?: boolean;
  /** Page locale; English (default) has no URL prefix. */
  locale?: LocaleCode;
}

const {
  title,
  description,
  keywords = ['oklch', 'color picker', 'css oklch', 'tailwind v4 theme', 'color palettes'],
  canonicalPath,
  schemaType = 'WebApplication',
  noindex = false,
  locale = 'en',
} = Astro.props;

// Pages pass an unprefixed canonical path; anything else (or a default
// canonicalPath) is normalized by stripping any locale prefix before the
// prefix is re-applied — `/hi/hex-to-oklch` + `hi` must never become
// `/hi/hi/hex-to-oklch`.
const basePath = getCanonicalPath(canonicalPath ?? Astro.url.pathname);
const localeConfig = getLocaleConfig(locale);

// Every absolute URL on the site derives from `site` in astro.config.mjs.
// A missing `site` is a build error, never a silent hard-coded fallback.
const site = Astro.site;
if (!site) {
  throw new Error('astro.config.mjs must define `site` — all canonical/OG/sitemap URLs derive from it.');
}

const localizedBasePath = localeConfig.isDefault
  ? basePath
  : basePath === '/'
    ? localeConfig.prefix
    : `${localeConfig.prefix}${basePath}`;
const canonicalUrl = new URL(localizedBasePath, site).href;
const ogImageUrl = new URL(ogImagePathFor(basePath), site).href;

// hreflang alternates for every locale of this page (incl. x-default →
// the English version). Suppressed on noindex pages — an unindexable page
// should not advertise localized twins it does not have.
const alternateLinks = noindex ? '' : generateAlternateLinks(basePath, site);

// Article dates come from the central nav config, keyed by the page's own
// canonical path — pages never hand their dates to the layout themselves.
const navSeo = getNavItemByPath(basePath)?.seo;
const datePublished = navSeo?.datePublished;
const dateModified = navSeo?.dateModified;
const isArticle = schemaType === 'Article';

// FAQ JSON-LD goes through localizedSeo so locale dictionaries can supply
// translated question/answer pairs; pages without an override keep the
// English faqs from navigation.ts.
const pageSeo = localizedSeo(basePath, locale, navSeo);

// JSON-LD graph: WebSite + Organization + the page's own type + breadcrumbs,
// assembled centrally in utils/schema.ts. This replaces the old flat node that
// stamped WebApplication fields (applicationCategory, offers) onto Article and
// CollectionPage pages, and the "OKLCH Colors Studio" name that matched no
// other metadata on the site.
const jsonLd = buildJsonLdGraph({
  site,
  canonicalPath: basePath,
  canonicalUrl,
  title,
  description,
  schemaType,
  datePublished,
  dateModified,
  faqs: pageSeo.faqs,
  noindex,
  locale,
});
---

<!doctype html>
<html lang={localeConfig.locale} dir={localeConfig.dir}>
  <head>
    <!-- Google tag (gtag.js) - deferred to first user interaction -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-DC8S1ZNSN7';
        var loaded = false;

        function loadGtag() {
          if (loaded) return;
          loaded = true;

          // Remove listeners
          document.removeEventListener('click', loadGtag, { passive: true });
          document.removeEventListener('scroll', loadGtag, { passive: true });
          window.removeEventListener('load', loadGtag);

          // Load gtag script
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        }

        // Load on first interaction (click, scroll, or after 3s idle)
        document.addEventListener('click', loadGtag, { passive: true });
        document.addEventListener('scroll', loadGtag, { passive: true });
        window.addEventListener('load', loadGtag);
        setTimeout(loadGtag, 3000);
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      THEME. Runs before anything is painted, so the document is already the
      right colour when the first frame arrives — the alternative is a dark
      flash on every load for every reader whose device is set to light.

      Resolution order: the reader's own stored choice first, then the device.
      Nothing is written back on a first visit, so "no preference recorded"
      keeps tracking the device — if the OS flips at sunset, the site flips
      with it. Only an actual click stores a value, and from that moment the
      device is no longer consulted.

      `is:inline` and untransformed on purpose: this has to be in the served
      HTML, in the head, synchronous, and byte-identical on every page. Being
      identical is also what makes it survive Astro's client-side router —
      `deselectScripts` skips a script whose text it has already executed, so
      after a navigation this block does not run again and the listeners it
      registered the first time are still the live ones.

      Two of those listeners matter:
        · click, delegated on `document` — the toggle button is replaced on
          every navigation, so a listener bound to the element would be dead
          after the first page change. Delegated, there is nothing to rebind.
        · `astro:after-swap` — the router copies the new document's attributes
          onto <html>, which *removes* `data-theme` (the server has no way to
          know it). Without this line the theme would silently reset to dark
          on every client-side navigation. It re-applies in the same task as
          the swap, so no frame of the wrong theme is ever shown.
    -->
    <script is:inline>
      (function () {
        var KEY = 'oklch-theme';
        var root = document.documentElement;

        function systemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }

        function storedTheme() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null;
          }
        }

        function resolve() {
          return storedTheme() || systemTheme();
        }

        function apply(theme) {
          root.setAttribute('data-theme', theme);
        }

        apply(resolve());

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          if (!target.closest('[data-theme-toggle]')) return;
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {
            /* Private mode: the toggle still works, it just won't persist. */
          }
          apply(next);
        });

        document.addEventListener('astro:after-swap', function () {
          apply(resolve());
        });

        var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)');
        if (mq) {
          var onPrefChange = function () {
            if (!storedTheme()) apply(systemTheme());
          };
          if (mq.addEventListener) mq.addEventListener('change', onPrefChange);
          else if (mq.addListener) mq.addListener(onPrefChange);
        }
      })();
    </script>

    <!--
      Client-side router. Without this, every page change is a full document
      load (fresh HTML parse, re-download, re-execute the bundle), which is what
      made moving between pages feel like a hard reload. It intercepts link
      clicks and `navigate()` from `astro:transitions/client`, swaps the DOM in
      place and cross-fades the result.
    -->
    <ClientRouter />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <!-- hreflang alternates: every locale of this page + x-default (English). -->
    {alternateLinks && <Fragment set:html={alternateLinks} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content="OKLCH Colors" />
    <meta property="og:locale" content={localeConfig.locale.replace('-', '_')} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {isArticle && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {isArticle && dateModified && (
      <meta property="article:modified_time" content={dateModified} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:image:alt" content={title} />

    <!--
      Geist / Geist Mono lead the stack per DESIGN.md, which uses them to keep
      numbers visually distinct from labels at small sizes. Inter and JetBrains
      Mono remain in the CSS font stack as fallbacks rather than being requested
      here, so a font-CDN hiccup degrades to the platform UI font instead of
      leaving every value unstyled.

      The stylesheet is loaded with the print/onload pattern so it never blocks
      the critical rendering path. The preconnect hints warm the connection
      early while the HTML parses.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink antialiased selection:bg-hairline selection:text-ink">
    <slot />
  </body>
</html>
