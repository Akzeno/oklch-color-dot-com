/* ═══════════════════════════════════════════════════════════════════════════
   SLIDERS
   ═══════════════════════════════════════════════════════════════════════════ */

input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  cursor: pointer;
  width: 100%;
  height: 44px;
  margin: 0;
}

input[type='range']::-webkit-slider-runnable-track {
  height: 8px;
  border-radius: 9999px;
  border: 1px solid var(--color-hairline);
  background: var(--track-gradient, var(--color-canvas-elevated));
}

input[type='range']::-moz-range-track {
  height: 8px;
  border-radius: 9999px;
  border: 1px solid var(--color-hairline);
  background: var(--track-gradient, var(--color-canvas-elevated));
}

/* The handle. Ink-on-black with a hairline of canvas behind it, so it stays
   legible over a fully saturated swatch of the same hue.
   Minimum 44x44px touch target per WCAG AA. */
input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  height: 44px;
  width: 44px;
  margin-top: -19px;
  border-radius: 9999px;
  background-color: var(--color-ink);
  border: 2px solid var(--color-canvas);
  box-shadow: var(--shadow-rest);
  transition: transform 100ms var(--ease-tap);
}

input[type='range']::-webkit-slider-thumb:hover {
  transform: scale(1.12);
}

input[type='range']::-moz-range-thumb {
  height: 44px;
  width: 44px;
  border-radius: 9999px;
  background-color: var(--color-ink);
  border: 2px solid var(--color-canvas);
  box-shadow: var(--shadow-rest);
  transition: transform 100ms var(--ease-tap);
}

input[type='range']::-moz-range-thumb:hover {
  transform: scale(1.12);
}

/* The focus halo is drawn in the theme's own ink at 25%, not in a literal
   off-white: on a light theme an off-white ring around an off-white thumb is
   not a ring, it is a rumour. */
input[type='range']:focus-visible::-webkit-slider-thumb {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink) 25%, transparent);
}